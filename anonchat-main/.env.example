# --- Telegram Bot Settings ---

# Your Bot Token from @BotFather
BOT_TOKEN=put_your_bot_token_here

# Admin IDs (Numeric IDs separated by commas)
# You can get your ID from @userinfobot
ADMIN_IDS=123456789

# (Optional) Required Channel ID for the Channel Lock feature
# Use numeric ID (e.g., -10012345678)
REQUIRED_CHANNEL_ID=0

# --- MongoDB ---
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB=anonchat
